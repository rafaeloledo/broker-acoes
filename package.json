{
  "name": "broker-acoes",
  "version": "2.0.0",
  "description": "High-performance Brazilian stock market (B3) web terminal and fundamental analysis platform powered by Bun",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server/index.ts",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "build": "bun run scripts/build.ts && bun x tsc --noEmit",
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
